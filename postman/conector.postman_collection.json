		{
			"name": "Accion",
			"item": [
				{
					"name": "Leer los mensajes de la bandeja",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Inbox has at least one message', function () {",
									"    pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://mailtrap.io/api/accounts/{{account_id}}/inboxes/{{inbox_id}}/messages",
							"protocol": "https",
							"host": [
								"mailtrap",
								"io"
							],
							"path": [
								"api",
								"accounts",
								"{{account_id}}",
								"inboxes",
								"{{inbox_id}}",
								"messages"
							]
						}
					},
					"response": []
				},
				{
					"name": "Enviar correo al sandbox",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response reports success', function () {",
									"    pm.expect(pm.response.json().success).to.eql(true);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from\": { \"email\": \"tienda@libreria.test\", \"name\": \"Libreria Web\" },\n  \"to\": [{ \"email\": \"cliente@ejemplo.test\" }],\n  \"subject\": \"Pedido #1001 recibido\",\n  \"text\": \"Gracias por su compra.\"\n}",
