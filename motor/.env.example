APP_NAME="Motor Libreria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Store (WooCommerce REST API v3)
WOOCOMMERCE_URL=https://libreria.local
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
# Store calls: timeout in seconds, attempts, base backoff in ms, products per page
STORE_TIMEOUT=10
STORE_TRIES=3
STORE_BACKOFF_MS=500
STORE_PER_PAGE=100

# External connector
CONECTOR_PROVEEDOR=
# Connector calls: timeout in seconds, attempts, base backoff in ms
CONECTOR_TIMEOUT=10
CONECTOR_TRIES=3
CONECTOR_BACKOFF_MS=500
# Mailtrap sandbox
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=

# AI address normalization
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Integration log: days a record is kept before the daily prune deletes it
INTEGRATION_LOG_RETENTION_DAYS=30
