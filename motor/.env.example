APP_NAME="Motor Libreria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Store (WooCommerce REST API v3)
WOOCOMMERCE_URL=https://libreria.local
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
# Store calls: timeout in seconds, attempts, base backoff in ms, products per page
STORE_TIMEOUT=10
STORE_TRIES=3
STORE_BACKOFF_MS=500
STORE_PER_PAGE=100
# Keep true. Set false only in your own .env when the local store has a self-signed certificate
STORE_VERIFY_SSL=true

# External connector
CONECTOR_PROVEEDOR=
# Connector calls: timeout in seconds, attempts, base backoff in ms
CONECTOR_TIMEOUT=10
CONECTOR_TRIES=3
CONECTOR_BACKOFF_MS=500
# Mailtrap sandbox
MAILTRAP_TOKEN=
MAILTRAP_INBOX_ID=

# AI address normalization
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Integration log: days a record is kept before the daily prune deletes it
INTEGRATION_LOG_RETENTION_DAYS=30
