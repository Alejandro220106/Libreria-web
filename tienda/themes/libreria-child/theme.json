{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FBF6EC" },
				{ "slug": "contrast", "name": "Contrast", "color": "#2B1D1A" },
				{ "slug": "accent-1", "name": "Accent 1", "color": "#D6B26A" },
				{ "slug": "accent-2", "name": "Accent 2", "color": "#EADFC8" },
				{ "slug": "accent-3", "name": "Accent 3", "color": "#7A2630" },
				{ "slug": "accent-4", "name": "Accent 4", "color": "#6B5F58" },
				{ "slug": "accent-5", "name": "Accent 5", "color": "#F3EAD8" },
				{ "slug": "accent-6", "name": "Accent 6", "color": "color-mix(in srgb, currentColor 20%, transparent)" }
			]
		},
		"layout": {
			"wideSize": "1280px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Poppins",
					"slug": "poppins",
					"fontFamily": "Poppins, sans-serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/poppins/Poppins-Regular.woff2" ],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Poppins",
							"fontDisplay": "swap"
						},
						{
							"src": [ "file:./assets/fonts/poppins/Poppins-SemiBold.woff2" ],
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontFamily": "Poppins",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"name": "DM Serif Display",
					"slug": "dm-serif-display",
					"fontFamily": "\"DM Serif Display\", Georgia, serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/dm-serif-display/DMSerifDisplay-Regular.woff2" ],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "\"DM Serif Display\"",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, sans-serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2" ],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope"
						}
					]
				},
				{
					"name": "Fira Code",
					"slug": "fira-code",
					"fontFamily": "\"Fira Code\", monospace",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/fira-code/FiraCode-VariableFont_wght.woff2" ],
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontFamily": "\"Fira Code\""
						}
					]
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|poppins",
			"fontSize": "1rem",
			"fontWeight": "400",
			"lineHeight": "1.6",
			"letterSpacing": "0"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|dm-serif-display",
					"fontWeight": "400"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent-3",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "30px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": {
					"fontSize": "0.9rem",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--accent-3) 85%, black)",
						"text": "var:preset|color|base"
					}
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var:preset|color|accent-3"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|dm-serif-display",
					"fontSize": "1.75rem",
					"fontWeight": "400"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.8rem",
					"fontWeight": "600",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				}
			}
		},
		"css": "html{scroll-padding-top:6rem}header.wp-block-template-part{position:sticky;top:var(--wp-admin--admin-bar--height,0px);z-index:100}.libreria-header{border-bottom:1px solid var(--wp--preset--color--accent-2);padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)}.libreria-header .wp-block-search__button,.libreria-header .wc-block-mini-cart__button,.libreria-header .wc-block-customer-account a{min-width:44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center}:where(a,button,input,select,summary,.wp-element-button):focus-visible{outline:2px solid var(--wp--preset--color--accent-3);outline-offset:2px}.libreria-footer{padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--50)}.libreria-footer a{color:var(--wp--preset--color--base);text-decoration:none}.libreria-footer h3{margin-bottom:.75rem}.libreria-footer a:hover{color:var(--wp--preset--color--accent-1);text-decoration:underline}.libreria-footer :where(a,button):focus-visible{outline-color:var(--wp--preset--color--base)}.libreria-footer-list{list-style:none;margin:0;padding:0}.libreria-footer-list li{margin:0 0 .5rem}.libreria-header .wp-block-search__button{padding:.75rem;border-radius:50%}"
	}
}
